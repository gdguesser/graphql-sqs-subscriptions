{
  "name": "graphql-sqs-subscriptions",
  "version": "0.1.0",
  "description": "AWS SDK v3 SQS PubSubEngine with single-process local fan-out for GraphQL subscriptions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run validate",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:integration:localstack": "vitest run --config vitest.integration.config.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "validate": "npm run test && npm run typecheck && npm run build && npm run lint && npm run format:check"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "amazon web services",
    "apollo",
    "aws",
    "graphql",
    "pubsub",
    "simple queue service",
    "sqs",
    "subscriptions"
  ],
  "author": "John Flockton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gdguesser/graphql-sqs-subscriptions.git"
  },
  "bugs": {
    "url": "https://github.com/gdguesser/graphql-sqs-subscriptions/issues"
  },
  "homepage": "https://github.com/gdguesser/graphql-sqs-subscriptions#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1104.0"
  },
  "peerDependencies": {
    "graphql": "^15.7.2 || ^16.0.0",
    "graphql-subscriptions": "^2.0.0 || ^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.11"
  }
}
